const express = require('express');
const path = require('path');
const app = express();
const PORT = process.env.PORT || 5000;

// 🔍 요청 URL 로그
app.use((req, res, next) => {
  console.log('🔍 요청됨:', req.url);
  next();
});

// 정적 파일 서빙
// server.js (위치는 serverforweb/ 안에 있음)
app.use(express.static(path.join(__dirname, '../siteforportfolio/build')));

  app.all('/{*any}', (req, res) => {
  res.sendFile(path.join(__dirname, '../siteforportfolio/build/index.html'));
});
app.listen(PORT, '0.0.0.0', () => {
  console.log(`🚀 Server running at http://localhost:${PORT}`);
});
